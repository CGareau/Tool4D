<?xml version="1.0" encoding="utf-8"?>

<!ELEMENT field EMPTY>
<!ATTLIST field
  kind (alpha|text|date|time|boolean|int16|int32|int64|real|float|blob|picture|object) #REQUIRED
  table_no CDATA #IMPLIED
  field_no CDATA #IMPLIED
  name CDATA #IMPLIED
  fixed_size CDATA #IMPLIED
  value_format CDATA #IMPLIED
  value_format_no CDATA #IMPLIED
>

<!ELEMENT text_settings EMPTY>
<!ATTLIST text_settings
  delimiter_record CDATA #REQUIRED
  delimiter_field CDATA #REQUIRED
  delimiter_file CDATA #IMPLIED
  title CDATA #IMPLIED
  with_column_title (true|false) #IMPLIED
  with_line_number (true|false) #IMPLIED
  first_imported_line CDATA #IMPLIED
  with_bom (true|false) #IMPLIED
  padding_alpha CDATA #IMPLIED
  padding_numerical CDATA #IMPLIED
  padding_date CDATA #IMPLIED
>

<!ELEMENT xml_settings EMPTY>
<!ATTLIST xml_settings
  export_dtd_mode (none|generate-inside|generate-outside|reference) #REQUIRED
  export_xsl_mode (none|apply|reference) #REQUIRED
  export_dtd_name CDATA #IMPLIED
  import_alternate_dtd CDATA #IMPLIED
  export_xsl_name CDATA #IMPLIED
  replace_spaces (true|false) #IMPLIED
  validate_xml (true|false) #IMPLIED
  encode_picture_as_png (true|false) #IMPLIED
  encode_binary_as_base64 (true|false) #IMPLIED
  with_indentation (true|false) #IMPLIED
>


